bazel_dep(name = "score_baselibs", version = "0.0.0")
local_path_override(
    module_name = "score_baselibs",
    path = "../..",
)

bazel_dep(name = "rules_cc", version = "0.2.17")

# C++ Toolchain configuration
bazel_dep(name = "score_bazel_platforms", version = "1.1.0")

bazel_dep(name = "score_bazel_cpp_toolchains", version = "1.0.5", dev_dependency = True)

# TODO: Switch to the next release (after 1.0.5)
git_override(
    module_name = "score_bazel_cpp_toolchains",
    commit = "90c377061e4c3585cb5b11b6e490413664179def",
    remote = "https://github.com/eclipse-score/bazel_cpp_toolchains.git",
)

gcc = use_extension("@score_bazel_cpp_toolchains//extensions:gcc.bzl", "gcc", dev_dependency = True)
gcc.toolchain(
    name = "score_gcc_x86_64_toolchain",
    target_cpu = "x86_64",
    target_os = "linux",
    use_default_package = True,
    version = "12.2.0",
)
gcc.toolchain(
    name = "score_gcc_aarch64_toolchain",
    target_cpu = "aarch64",
    target_os = "linux",
    use_default_package = True,
    version = "12.2.0",
)
gcc.toolchain(
    name = "score_qcc_x86_64_toolchain",
    sdp_version = "8.0.4",
    target_cpu = "x86_64",
    target_os = "qnx",
    use_default_package = True,
    version = "12.2.0",
)
gcc.toolchain(
    name = "score_qcc_aarch64_toolchain",
    sdp_version = "8.0.4",
    target_cpu = "aarch64",
    target_os = "qnx",
    use_default_package = True,
    version = "12.2.0",
)
gcc.sdp(
    name = "score_qcc_x86_64_toolchain_805_pkg",
    build_file = "@score_bazel_cpp_toolchains//packages/qnx/x86_64/sdp/8.0.0:sdp.BUILD",
    sha256 = "eaf000e6d8fe8b96685a0c0d5041e9fe62fe36c9fc3f0854033a7be9fbec8c89",
    type = "tar.gz",
    url = "https://api.github.com/repos/eclipse-score/qnx_sdp_pkg/releases/assets/706198299",
)
gcc.toolchain(
    name = "score_qcc_x86_64_toolchain_805",
    sdp_to_link = "score_qcc_x86_64_toolchain_805_pkg",
    sdp_version = "8.0.4",  # QNX SDP version for this toolchain is in fact 8.0.5
    target_cpu = "x86_64",
    target_os = "qnx",
)

# Same SDP archive as x86_64, it is downloaded once and extracted per architecture.
gcc.sdp(
    name = "score_qcc_aarch64_toolchain_805_pkg",
    build_file = "@score_bazel_cpp_toolchains//packages/qnx/aarch64/sdp/8.0.0:sdp.BUILD",
    sha256 = "eaf000e6d8fe8b96685a0c0d5041e9fe62fe36c9fc3f0854033a7be9fbec8c89",
    type = "tar.gz",
    url = "https://api.github.com/repos/eclipse-score/qnx_sdp_pkg/releases/assets/706198299",
)
gcc.toolchain(
    name = "score_qcc_aarch64_toolchain_805",
    sdp_to_link = "score_qcc_aarch64_toolchain_805_pkg",
    sdp_version = "8.0.4",  # QNX SDP version for this toolchain is in fact 8.0.5
    target_cpu = "aarch64",
    target_os = "qnx",
)
use_repo(
    gcc,
    "score_gcc_aarch64_toolchain",
    "score_gcc_x86_64_toolchain",
    "score_qcc_aarch64_toolchain",
    "score_qcc_aarch64_toolchain_805",
    "score_qcc_aarch64_toolchain_805_pkg",
    "score_qcc_aarch64_toolchain_pkg",
    "score_qcc_x86_64_toolchain",
    "score_qcc_x86_64_toolchain_805",
    "score_qcc_x86_64_toolchain_805_pkg",
    "score_qcc_x86_64_toolchain_pkg",
)

# QNX Image File System (IFS) toolchain configuration (for testing)

bazel_dep(name = "score_rules_imagefs", version = "0.0.3", dev_dependency = True)

imagefs = use_extension("@score_rules_imagefs//extensions:imagefs.bzl", "imagefs", dev_dependency = True)
imagefs.toolchain(
    name = "score_qnx_x86_64_ifs_toolchain",
    sdp_to_import = "@score_qcc_x86_64_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "x86_64",
    target_os = "qnx",
    type = "ifs",
)
imagefs.toolchain(
    name = "score_qnx_aarch64_ifs_toolchain",
    sdp_to_import = "@score_qcc_aarch64_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    type = "ifs",
)
imagefs.toolchain(
    name = "score_qnx_x86_64_ifs_toolchain_805",
    sdp_to_import = "@score_qcc_x86_64_toolchain_805_pkg",
    sdp_version = "8.0.0",
    target_cpu = "x86_64",
    target_os = "qnx",
    type = "ifs",
)
imagefs.toolchain(
    name = "score_qnx_aarch64_ifs_toolchain_805",
    sdp_to_import = "@score_qcc_aarch64_toolchain_805_pkg",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    type = "ifs",
)
use_repo(
    imagefs,
    "score_qnx_aarch64_ifs_toolchain",
    "score_qnx_aarch64_ifs_toolchain_805",
    "score_qnx_x86_64_ifs_toolchain",
    "score_qnx_x86_64_ifs_toolchain_805",
)

# Testing
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

bazel_dep(name = "score_qnx_unit_tests", version = "0.2.0", dev_dependency = True)
