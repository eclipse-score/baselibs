# Do not use automatically C++ generated toolchains
build --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

common --registry=https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/
common --registry=https://bcr.bazel.build

common --experimental_repository_downloader_retries=10
common --experimental_scale_timeouts=2.0
common --http_connector_attempts=10
common --http_connector_retry_max_timeout=30s
common --http_timeout_scaling=2.0

# Unset ANDROID_HOME to prevent rules_android from searching for the Android SDK.
# rules_android is a transitive dependency, and on GitHub runners the Android SDK
# directory is often deleted while the ANDROID_HOME environment variable remains set.
common --action_env=ANDROID_HOME=""

common --extra_toolchains=@score_gcc_x86_64_toolchain//:x86_64-linux-gcc_12.2.0
common --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_unknown_linux_gnu
common --host_platform=@score_bazel_platforms//:x86_64-linux-gcc_12.2.0-posix
common --//score/json:base_library=nlohmann

build --java_language_version=17
build --tool_java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_runtime_version=remotejdk_17
build --credential_helper="*.qnx.com=%workspace%/.github/tools/qnx_credential_helper.py"
build --features=minimal_warnings --features=-strict_warnings --features=warnings_as_errors
build --incompatible_strict_action_env
build --per_file_copt=external/.*google_benchmark.*@-Wno-error

# Common flags for tests
test:_bl_common --build_tests_only
test --test_output=errors

# Target configuration for CPU:x86-64|OS:Linux build (do not use it in case of system toolchains!)
build:bl-x86_64-linux --platforms=@score_bazel_platforms//:x86_64-linux-gcc_12.2.0-posix
build:bl-x86_64-linux --extra_toolchains=@score_gcc_x86_64_toolchain//:x86_64-linux-gcc_12.2.0
build:bl-x86_64-linux --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_unknown_linux_gnu
test:bl-x86_64-linux --config=_bl_common

# Target configuration for CPU:AArch64|OS:Linux build (do not use it in case of system toolchains!)
build:bl-aarch64-linux --platforms=@score_bazel_platforms//:aarch64-linux-gcc_12.2.0-posix
build:bl-aarch64-linux --extra_toolchains=@score_gcc_aarch64_toolchain//:aarch64-linux-gcc_12.2.0
build:bl-aarch64-linux --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_aarch64_unknown_linux_gnu
test:bl-aarch64-linux --config=_bl_common
test:bl-aarch64-linux --test_timeout=300
test:bl-aarch64-linux --run_under=//:qemu_aarch64
test:bl-aarch64-linux --test_tag_filters=-no_rust_doc_test

# Target configuration for CPU:x86-64|OS:QNX build (do not use it in case of system toolchains!)
build:bl-x86_64-qnx --platforms=@score_bazel_platforms//:x86_64-qnx-sdp_8.0.0-posix
build:bl-x86_64-qnx --extra_toolchains=@score_qcc_x86_64_toolchain//:x86_64-qnx-sdp_8.0.0
build:bl-x86_64-qnx --extra_toolchains=@score_qnx_x86_64_ifs_toolchain//:ifs-x86_64-qnx-sdp_8.0.0
build:bl-x86_64-qnx --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_pc_nto_qnx800
test:bl-x86_64-qnx --config=_bl_common
test:bl-x86_64-qnx --run_under=@score_qnx_unit_tests//src:run_under_qnx
test:bl-x86_64-qnx --test_lang_filters=cc,rust

# Target configuration for CPU:AArch64|OS:QNX build (do not use it in case of system toolchains!)
build:bl-aarch64-qnx --platforms=@score_bazel_platforms//:aarch64-qnx-sdp_8.0.0-posix
build:bl-aarch64-qnx --extra_toolchains=@score_qcc_aarch64_toolchain//:aarch64-qnx-sdp_8.0.0
build:bl-aarch64-qnx --extra_toolchains=@score_qnx_aarch64_ifs_toolchain//:ifs-aarch64-qnx-sdp_8.0.0
build:bl-aarch64-qnx --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_aarch64_unknown_nto_qnx800
test:bl-aarch64-qnx --config=_bl_common
test:bl-aarch64-qnx --test_timeout=300
test:bl-aarch64-qnx --run_under=@score_qnx_unit_tests//src:run_under_qnx
test:bl-aarch64-qnx --test_lang_filters=cc,rust

# Clippy linting for Rust
build:clippy --aspects=@score_rust_policies//clippy:linters.bzl%clippy_strict
build:clippy --output_groups=+rules_lint_human
build:clippy --@aspect_rules_lint//lint:fail_on_violation=true

# LLVM source-based coverage (C++ + Rust): --config=llvm_cov
import %workspace%/tools/coverage/coverage.bazelrc

# Sanitizer configuration for C++ and Rust.
# Runtime options, suppressions and the test wrapper come from @score_cpp_policies//sanitizers,
# mirroring its sanitizers.bazelrc, which Bazel cannot import from an external module.
# Compile and link flags still come from the score_bazel_cpp_toolchains features; they are
# replaced by the policy-owned `score_*` features with eclipse-score/baselibs#519.
# Those features already add `-g`, so only stripping has to be disabled here.
build:_bl_sanitizer_common --strip=never
# Partial enablement of sanitizers for Rust. Compile-time checks are not available.
# Final link of `rust_binary` and `rust_test` is routed through the C++ toolchain linker.
build:_bl_sanitizer_common --@rules_rust//rust/settings:experimental_use_cc_common_link=True
# Allow `cc_common.link` to use allocator libraries with mangled symbols, as provided by rustc 1.90.
build:_bl_sanitizer_common --@rules_rust//rust/settings:experimental_use_allocator_libraries_with_mangled_symbols=True
test:_bl_sanitizer_common --run_under=@score_cpp_policies//sanitizers:wrapper

build:asan --config=_bl_sanitizer_common
build:asan --features=asan
build:asan --@score_cpp_policies//sanitizers/flags:asan=True
build:asan --platform_suffix=asan

build:ubsan --config=_bl_sanitizer_common
build:ubsan --features=ubsan
build:ubsan --@score_cpp_policies//sanitizers/flags:ubsan=True
build:ubsan --platform_suffix=ubsan

build:lsan --config=_bl_sanitizer_common
build:lsan --features=lsan
build:lsan --@score_cpp_policies//sanitizers/flags:lsan=True
build:lsan --platform_suffix=lsan

build:tsan --config=_bl_sanitizer_common
build:tsan --features=tsan
build:tsan --@score_cpp_policies//sanitizers/flags:tsan=True
build:tsan --platform_suffix=tsan

# Composite configs. The last --platform_suffix wins, overriding the single-sanitizer ones.
build:asan_ubsan_lsan --config=asan
build:asan_ubsan_lsan --config=ubsan
build:asan_ubsan_lsan --config=lsan
build:asan_ubsan_lsan --platform_suffix=asan_ubsan_lsan

build:tsan_ubsan --config=tsan
build:tsan_ubsan --config=ubsan
build:tsan_ubsan --platform_suffix=tsan_ubsan

# Clang-Tidy configuration for C++
build:clang-tidy --aspects=//tools/lint:linters.bzl%clang_tidy_aspect
build:clang-tidy --output_groups=+rules_lint_human
build:clang-tidy --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:clang-tidy --@aspect_rules_lint//lint:fail_on_violation=true
# Once https://github.com/eclipse-score/baselibs/issues/519 is resolved we can remove this line:
build:clang-tidy --copt=-Wno-error=deprecated-declarations
build:clang-tidy --copt=-ffp-exception-behavior=strict
build:clang-tidy --copt=-frounding-math

# Ruff linting for Python
build:ruff --aspects=//tools/lint:linters.bzl%ruff_aspect
build:ruff --output_groups=+rules_lint_human
build:ruff --@aspect_rules_lint//lint:fail_on_violation=true

# All lint aspects in one build, for CI. Adding a linter here only means
# adding a --config line, not duplicating its flags.
build:lint --config=clang-tidy
build:lint --config=clippy
build:lint --config=ruff

# Import user-specific configurations
try-import %workspace%/user.bazelrc
