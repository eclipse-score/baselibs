@startuml
activate Application
Application --> JsonData : FromBuffer(StringView)

activate JsonData
JsonData --> JsonData : ParseBom()
activate JsonData #LightGrey

JsonData --> JsonOps : JsonOps(JsonData&)

activate JsonOps
JsonOps --> JsonData
deactivate JsonOps

JsonData --> JsonOps : ReadString()

activate JsonOps
JsonOps --> JsonData
deactivate JsonOps

deactivate JsonData
JsonData --> Application
deactivate JsonData

Application --> Parser : Parser(JsonData&)

activate Parser
Parser --> StructureParser : StructureParser(JsonData&)

activate StructureParser
StructureParser --> JsonOps : JsonOps(JsonData&)

activate JsonOps
JsonOps --> StructureParser
deactivate JsonOps

StructureParser --> Parser
deactivate StructureParser

Parser --> Application
deactivate Parser

Application --> Parser : Parse()

activate Parser
Parser --> StructureParser : Parse()

activate StructureParser
StructureParser --> JsonOps : SkipWhitespace()

activate JsonOps
JsonOps --> StructureParser
deactivate JsonOps

loop ParserState == kRunning
StructureParser --> StructureParser : ParseValue()
activate StructureParser #LightGrey

StructureParser --> JsonOps : SkipWhitespace()

activate JsonOps
JsonOps --> StructureParser
deactivate JsonOps

StructureParser --> JsonData : GetClearedStringBuffer()
activate JsonData
JsonData --> StructureParser
deactivate JsonData

StructureParser --> JsonOps : Take()
activate JsonOps

JsonOps --> JsonOps : TryTake()

JsonOps --> StructureParser
deactivate JsonOps

StructureParser --> StructureParser : ParseStartObject()
activate StructureParser #DarkGray
note right : For instance, an opening curly bracket was found

StructureParser --> StructureValidator : OpenObject()
activate StructureValidator
alt A completed value is not followed by a comma
StructureValidator --> StructureParser : Error Invalid JSON
else Inside an object without a key
StructureValidator --> StructureParser : Error Invalid JSON
else
  StructureValidator --> StructureValidator : Consume the pending key
  StructureValidator --> StructureValidator : Push the object onto the open containers
  StructureValidator --> StructureParser
  deactivate StructureValidator
end

StructureParser --> Parser : OnStartObject()

activate Parser #LightGrey
note left : Call to user implementation
...
Parser --> StructureParser
deactivate Parser

deactivate StructureParser
deactivate StructureParser
end

StructureParser --> Parser
deactivate StructureParser

Parser --> Application
deactivate Parser

@enduml
