@startuml

' Byte types of bit_manipulation.h; the bit functions are free function templates.

class HalfByte {
    + HalfByte(value : std::uint8_t)
}

class Byte {
    + Byte(upper_half : HalfByte, lower_half : HalfByte)
    + Byte(value : std::uint8_t)
    + UpperHalfByte() : HalfByte <<const>>
    + LowerHalfByte() : HalfByte <<const>>
}

Byte *-- HalfByte

@enduml
