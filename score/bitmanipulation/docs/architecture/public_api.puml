' Public interface surface of bit_manipulation.h (SetBit/ClearBit/ToggleBit/
' CheckBit), referenced by FailureMode.interface in
' ../safety_analysis/trlc/failuremodes.trlc. All four failure modes there are
' generic HAZOP fault models that apply equally to every free function, so
' they all reference this single, aggregate "BitOperations" interface rather
' than one interface item per function.

@startuml public_api

package "BitmanipulationAPI" as BitmanipulationAPI {
    interface "BitOperations" as BitOperations
}

@enduml
