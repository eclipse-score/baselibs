@startuml bitmanipulation_public_api

' Public API of the bitmanipulation component; all entries are free function templates.
package baselibs {
    interface BitManipulationApi {
        + SetBit(value : T, position : std::size_t) : bool
        + ClearBit(value : T, position : std::size_t) : bool
        + ToggleBit(value : T, position : std::size_t) : bool
        + CheckBit(value : T, position : std::size_t) : bool
        + GetByte(raw_bytes : T) : std::uint8_t
    }

    interface BitmaskOperatorsApi {
        + operator|(lhs : T, rhs : T) : T
        + operator&(lhs : T, rhs : T) : bool
        + operator^(lhs : T, rhs : T) : T
        + operator~(other : T) : T
        + operator|=(lhs : T, rhs : T) : T
        + operator&=(lhs : T, rhs : T) : T
    }
}

@enduml
