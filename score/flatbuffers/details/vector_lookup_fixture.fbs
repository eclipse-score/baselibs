// Minimal schema used only by flatbuffers_vector_test.cpp to exercise
// Vector<T> APIs that require schema-generated code: LookupByKey /
// MutableLookupByKey (need a keyed table with KeyCompareWithValue) and
// VectorCast (needs a real table type deriving from ::flatbuffers::Table).

namespace score.flatbuffers.test.fixture;

// A keyed table. The `id` field carries the `key` attribute, which makes flatc
// generate KeyCompareWithValue()/KeyCompareLessThan(), enabling both
// CreateVectorOfSortedTables() and Vector<Offset<Item>>::LookupByKey().
table Item {
  id:int (key);
  label:string;
}

// Root object holding a vector of keyed tables.
table Container {
  items:[Item];
}

root_type Container;
