# S-CORE toolchain configuration
#
# The S-CORE project maintains this configuration centrally.
# Please make module-specific changes in your module's .bazelrc.

# Host defaults, also in effect for targets built without one of the configs below.
common --host_platform=@score_bazel_platforms//:x86_64-linux-gcc_12.2.0-posix
common --extra_toolchains=@score_gcc_x86_64_toolchain//:x86_64-linux-gcc_12.2.0
common --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_unknown_linux_gnu

# Target configuration for CPU:x86-64|OS:Linux build (do not use it in case of system toolchains!)
build:score-linux-x86_64 --platforms=@score_bazel_platforms//:x86_64-linux-gcc_12.2.0-posix
build:score-linux-x86_64 --extra_toolchains=@score_gcc_x86_64_toolchain//:x86_64-linux-gcc_12.2.0
build:score-linux-x86_64 --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_unknown_linux_gnu

# Target configuration for CPU:AArch64|OS:Linux build (do not use it in case of system toolchains!)
build:score-linux-aarch64 --platforms=@score_bazel_platforms//:aarch64-linux-gcc_12.2.0-posix
build:score-linux-aarch64 --extra_toolchains=@score_gcc_aarch64_toolchain//:aarch64-linux-gcc_12.2.0
build:score-linux-aarch64 --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_aarch64_unknown_linux_gnu

# Target configuration for CPU:x86-64|OS:QNX build (do not use it in case of system toolchains!)
build:score-qnx-x86_64 --platforms=@score_bazel_platforms//:x86_64-qnx-sdp_8.0.0-posix
build:score-qnx-x86_64 --extra_toolchains=@score_qcc_x86_64_toolchain//:x86_64-qnx-sdp_8.0.0
build:score-qnx-x86_64 --extra_toolchains=@score_qnx_x86_64_ifs_toolchain//:ifs-x86_64-qnx-sdp_8.0.0
build:score-qnx-x86_64 --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_pc_nto_qnx800

# Target configuration for CPU:AArch64|OS:QNX build (do not use it in case of system toolchains!)
build:score-qnx-aarch64 --platforms=@score_bazel_platforms//:aarch64-qnx-sdp_8.0.0-posix
build:score-qnx-aarch64 --extra_toolchains=@score_qcc_aarch64_toolchain//:aarch64-qnx-sdp_8.0.0
build:score-qnx-aarch64 --extra_toolchains=@score_qnx_aarch64_ifs_toolchain//:ifs-aarch64-qnx-sdp_8.0.0
build:score-qnx-aarch64 --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_aarch64_unknown_nto_qnx800

# Sanitizer configurations for SCORE Linux toolchains.
# Select a SCORE Linux toolchain along with the sanitizer configuration.
# bazel test --config=score-linux-x86_64 --config=asan_ubsan_lsan //...
# Runtime options, suppressions and the test wrapper come from @score_cpp_policies//sanitizers.
# The `score_*` features are injected in MODULE.bazel and add `-g1`, so only stripping is left.
build:_score_sanitizer_common --strip=never
# Partial enablement of sanitizers for Rust. Compile-time checks are not available.
# Final link of `rust_binary` and `rust_test` is routed through the C++ toolchain linker.
build:_score_sanitizer_common --@rules_rust//rust/settings:experimental_use_cc_common_link=True
# Allow `cc_common.link` to use allocator libraries with mangled symbols, as provided by rustc 1.90.
build:_score_sanitizer_common --@rules_rust//rust/settings:experimental_use_allocator_libraries_with_mangled_symbols=True
test:_score_sanitizer_common --run_under=@score_cpp_policies//sanitizers:wrapper

build:asan --config=_score_sanitizer_common
build:asan --features=score_asan
build:asan --@score_cpp_policies//sanitizers/flags:asan=True
build:asan --platform_suffix=asan

build:ubsan --config=_score_sanitizer_common
# Each toolchain knows only its own variant and ignores the other name.
build:ubsan --features=score_ubsan_gcc
build:ubsan --features=score_ubsan_clang
build:ubsan --@score_cpp_policies//sanitizers/flags:ubsan=True
build:ubsan --platform_suffix=ubsan

build:lsan --config=_score_sanitizer_common
build:lsan --features=score_lsan
build:lsan --@score_cpp_policies//sanitizers/flags:lsan=True
build:lsan --platform_suffix=lsan

build:tsan --config=_score_sanitizer_common
build:tsan --features=score_tsan
build:tsan --@score_cpp_policies//sanitizers/flags:tsan=True
build:tsan --platform_suffix=tsan

# Composite configs. The last --platform_suffix wins, overriding the single-sanitizer ones.
build:asan_ubsan_lsan --config=asan
build:asan_ubsan_lsan --config=ubsan
build:asan_ubsan_lsan --config=lsan
build:asan_ubsan_lsan --platform_suffix=asan_ubsan_lsan

build:tsan_ubsan --config=tsan
build:tsan_ubsan --config=ubsan
build:tsan_ubsan --platform_suffix=tsan_ubsan
